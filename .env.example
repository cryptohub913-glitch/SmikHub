# Telegram token of the SmikHub platform bot itself (from @BotFather)
BOT_TOKEN=123456:REPLACE_ME

# Token of the separate check-bot that advertisers add as admin to their channel/chat
# to verify real joins/leaves for "Купить ОП" orders. Optional — the main bot and API
# work without it, but "Buy AP" orders targeting a channel/chat won't get verified
# statistics or billing until it's set.
CHECK_BOT_TOKEN=123456:REPLACE_ME

# SQLAlchemy async database URL.
# Локально (без Docker) относительный путь ниже — ок, файл живёт рядом с кодом.
# В Docker/docker-compose это значение перекрывается в docker-compose.yml на
# /app/data/smikhub.db (внутрь примонтированного volume) — не убирайте тот override,
# иначе база будет пересоздаваться пустой при каждом пересборке контейнера.
DATABASE_URL=sqlite+aiosqlite:///./smikhub.db

# 32 url-safe base64 bytes, e.g. generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=REPLACE_ME_WITH_GENERATED_FERNET_KEY

API_HOST=0.0.0.0
API_PORT=8000

# Telegram user id(s) allowed to use /admin, comma-separated. Empty = nobody has access.
ADMIN_USER_IDS=

# Send Crypto Pay API (help.send.tg) — powers real "Кабинет" deposits/withdrawals.
# Optional — without it, "Кабинет" still shows the balance, but deposit/withdraw are
# disabled with a clear message instead of failing.
SEND_API_TOKEN=
# Verify this against your Send app dashboard — the docs Claude had access to didn't
# spell out the exact base URL, this mirrors @CryptoBot's pay.crypt.bot convention.
SEND_API_BASE_URL=https://pay.send.tg/api
